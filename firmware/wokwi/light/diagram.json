{
  "version": 1,
  "author": "HISN",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "ledRed", "top": -80, "left": 200, "attrs": { "color": "red" } },
    { "type": "wokwi-led", "id": "ledGreen", "top": -80, "left": 260, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "rRed", "top": 10, "left": 180, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rGreen", "top": 10, "left": 240, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btnVeto", "top": 80, "left": 300, "attrs": { "color": "red", "label": "STOP" } },
    { "type": "wokwi-buzzer", "id": "buzz", "top": 150, "left": 200, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:18", "rRed:1", "red", [] ],
    [ "rRed:2", "ledRed:A", "red", [] ],
    [ "ledRed:C", "esp:GND.1", "black", [] ],
    [ "esp:19", "rGreen:1", "green", [] ],
    [ "rGreen:2", "ledGreen:A", "green", [] ],
    [ "ledGreen:C", "esp:GND.1", "black", [] ],
    [ "btnVeto:1.l", "esp:27", "purple", [] ],
    [ "btnVeto:2.l", "esp:GND.1", "black", [] ],
    [ "buzz:2", "esp:26", "magenta", [] ],
    [ "buzz:1", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
